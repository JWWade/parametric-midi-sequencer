{
  "metadata": {
    "title": "Harmonic Expansion/Contraction Example",
    "description": "Demonstrates the 'expand' transform type, which expands or contracts chord voicings around their centroid. Amount > 1 expands intervals; 0 < amount < 1 contracts them. Useful for creating dynamic harmonic opening and closing effects.",
    "author": "Parametric MIDI Sequencer",
    "version": "1.0"
  },
  
  "scale": "major",
  "root": "G",
  
  "constraints": {
    "minSharedPitches": 1,
    "transformDepth": 2,
    "pitchCenterCycle": 0,
    
    "shapeTransform": {
      "type": "expand",
      "amount": 1.5
    }
  },
  
